<%- include('../partials/header') %>

<div class="app-wrapper">
    <%- include('../partials/sidebar') %>

    <div class="main-content">
        <%- include('../partials/topbar') %>

        <div class="container-fluid py-4">

            <!-- Page Header -->
            <div class="d-flex align-items-center justify-content-between mb-4 flex-wrap gap-2">
                <div>
                    <h4 class="fw-bold mb-1" style="color: var(--mps-navy);">
                        <i class="bi bi-folder2-open me-2 text-warning"></i>Case Register
                    </h4>
                    <p class="text-muted small mb-0">All Occurrence Book (OB) entries recorded at Limbe Police Station.</p>
                </div>
                <a href="/cases/new" class="btn btn-navy">
                    <i class="bi bi-plus-circle-fill me-1"></i>Register New Case
                </a>
            </div>

            <!-- Flash Alert Messages -->
            <% if (typeof success !== 'undefined' && success && success.length > 0) { %>
                <div class="alert alert-success alert-dismissible fade show small mb-4" role="alert">
                    <i class="bi bi-check-circle-fill me-2"></i><%= success %>
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            <% } %>

            <% if (typeof error !== 'undefined' && error && error.length > 0) { %>
                <div class="alert alert-danger alert-dismissible fade show small mb-4" role="alert">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i><%= error %>
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            <% } %>

            <!-- Case Register Table -->
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-navy text-white d-flex align-items-center justify-content-between py-3">
                    <h6 class="mb-0 fw-bold">
                        <i class="bi bi-journal-text me-2 text-warning"></i>All Recorded Cases
                    </h6>
                    <span class="badge bg-gold text-dark"><%= cases.length %> Total</span>
                </div>
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead>
                            <tr>
                                <th>OB Number</th>
                                <th>Complainant</th>
                                <th>Category</th>
                                <th>Priority</th>
                                <th>Status</th>
                                <th>Unit</th>
                                <th>Intake Officer</th>
                                <th>Assigned To</th>
                                <th>Date Registered</th>
                                <th class="text-end">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if (cases.length === 0) { %>
                                <tr>
                                    <td colspan="10" class="text-center py-5 text-muted">
                                        <i class="bi bi-inbox fs-2 d-block mb-2"></i>
                                        No cases have been registered yet.
                                        <br>
                                        <a href="/cases/new" class="small">Register the first case &rarr;</a>
                                    </td>
                                </tr>
                            <% } else { %>
                                <% cases.forEach(item => { %>
                                    <tr>
                                        <td class="fw-bold font-monospace" style="color: var(--mps-navy);">
                                            <%= item.ob_number %>
                                        </td>
                                        <td class="small fw-semibold"><%= item.complainant_name %></td>
                                        <td class="small"><%= item.crime_category || '—' %></td>
                                        <td>
                                            <% if (item.priority === 'Critical') { %>
                                                <span class="badge badge-priority-critical">CRITICAL</span>
                                            <% } else if (item.priority === 'High') { %>
                                                <span class="badge badge-priority-high">HIGH</span>
                                            <% } else if (item.priority === 'Medium') { %>
                                                <span class="badge badge-priority-medium">MEDIUM</span>
                                            <% } else { %>
                                                <span class="badge badge-priority-low">LOW</span>
                                            <% } %>
                                        </td>
                                        <td>
                                            <% if (item.status === 'Closed') { %>
                                                <span class="badge badge-case-closed">Closed</span>
                                            <% } else if (item.status === 'Under Investigation') { %>
                                                <span class="badge badge-case-investigation">Under Investigation</span>
                                            <% } else if (item.status === 'Court Pending') { %>
                                                <span class="badge badge-case-open">Court Pending</span>
                                            <% } else if (item.status === 'Archived') { %>
                                                <span class="badge badge-case-archived">Archived</span>
                                            <% } else { %>
                                                <span class="badge bg-light text-dark border">Reported</span>
                                            <% } %>
                                        </td>
                                        <td class="small text-muted"><%= item.unit_name || '—' %></td>
                                        <td class="small"><%= item.intake_officer_name || '—' %></td>
                                        <td class="small">
                                            <% if (item.assigned_officer_id) { %>
                                                <%= item.assigned_officer_name %>
                                            <% } else { %>
                                                <span class="text-muted fst-italic">Unassigned</span>
                                            <% } %>
                                        </td>
                                        <td class="small text-muted"><%= new Date(item.created_at).toLocaleDateString() %></td>
                                        <td class="text-end">
                                            <a href="/cases/<%= item.id %>" class="btn btn-sm btn-outline-navy">
                                                <i class="bi bi-eye-fill me-1"></i>View
                                            </a>
                                        </td>
                                    </tr>
                                <% }) %>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            </div>

        </div>
    </div>
</div>

<%- include('../partials/footer') %>
