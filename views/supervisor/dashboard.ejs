<%- include('../partials/header') %>
<%- include('../partials/sidebar') %>

<div class="container-fluid py-4">
    <!-- Page Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 mb-0 text-gray-800">Supervisor Command Dashboard</h1>
            <p class="text-muted small mb-0">Station operational oversight, case distribution, and status approvals</p>
        </div>
        <div>
            <span class="badge bg-primary px-3 py-2">Station: Limbe Central</span>
        </div>
    </div>

    <!-- Alert Messages -->
    <% if (typeof error !== 'undefined' && error) { %>
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="fas fa-exclamation-circle me-2"></i><%= error %>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    <% } %>

    <% if (typeof success !== 'undefined' && success) { %>
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fas fa-check-circle me-2"></i><%= success %>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    <% } %>

    <!-- KPI Summary Cards -->
    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="card border-0 border-start border-4 border-warning shadow-sm h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <div class="text-uppercase text-muted fw-bold small">Unassigned Cases</div>
                            <div class="h2 mb-0 fw-bold text-dark"><%= kpi.unassigned %></div>
                        </div>
                        <div class="rounded-circle bg-warning bg-opacity-10 p-3 text-warning fs-3">
                            <i class="fas fa-folder-open"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card border-0 border-start border-4 border-info shadow-sm h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <div class="text-uppercase text-muted fw-bold small">Pending Approvals</div>
                            <div class="h2 mb-0 fw-bold text-dark"><%= kpi.pendingApprovals %></div>
                        </div>
                        <div class="rounded-circle bg-info bg-opacity-10 p-3 text-info fs-3">
                            <i class="fas fa-clipboard-check"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card border-0 border-start border-4 border-success shadow-sm h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <div class="text-uppercase text-muted fw-bold small">Active Investigations</div>
                            <div class="h2 mb-0 fw-bold text-dark"><%= kpi.activeCases %></div>
                        </div>
                        <div class="rounded-circle bg-success bg-opacity-10 p-3 text-success fs-3">
                            <i class="fas fa-search-location"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Main Content Section: Unassigned Queue & Pending Approvals -->
    <div class="row g-4 mb-4">
        
        <!-- Unassigned Cases Queue -->
        <div class="col-lg-7">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                    <h5 class="card-title mb-0 fw-bold text-dark">
                        <i class="fas fa-exclamation-triangle text-warning me-2"></i>Unassigned Case Queue
                    </h5>
                    <span class="badge bg-warning text-dark"><%= unassignedCases.length %> Pending</span>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Case Ref</th>
                                    <th>Title & Category</th>
                                    <th>Priority</th>
                                    <th>Reg. Date</th>
                                    <th class="text-end">Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% if (unassignedCases.length === 0) { %>
                                    <tr>
                                        <td colspan="5" class="text-center py-4 text-muted">
                                            <i class="fas fa-check-circle text-success fs-4 d-block mb-2"></i>
                                            All registered cases have been assigned!
                                        </td>
                                    </tr>
                                <% } else { %>
                                    <% unassignedCases.forEach(item => { %>
                                        <tr>
                                            <td class="fw-bold text-primary">#<%= item.case_number %></td>
                                            <td>
                                                <div class="fw-semibold text-dark"><%= item.title %></div>
                                                <small class="text-muted"><%= item.crime_category %></small>
                                            </td>
                                            <td>
                                                <% if (item.priority === 'CRITICAL') { %>
                                                    <span class="badge bg-danger">CRITICAL</span>
                                                <% } else if (item.priority === 'HIGH') { %>
                                                    <span class="badge bg-warning text-dark">HIGH</span>
                                                <% } else if (item.priority === 'MEDIUM') { %>
                                                    <span class="badge bg-info text-dark">MEDIUM</span>
                                                <% } else { %>
                                                    <span class="badge bg-secondary">LOW</span>
                                                <% } %>
                                            </td>
                                            <td><%= new Date(item.created_at).toLocaleDateString() %></td>
                                            <td class="text-end">
                                                <button type="button" 
                                                        class="btn btn-sm btn-primary btn-assign"
                                                        data-bs-toggle="modal" 
                                                        data-bs-target="#assignModal"
                                                        data-case-id="<%= item.id %>"
                                                        data-case-ref="<%= item.case_number %>"
                                                        data-case-title="<%= item.title %>">
                                                    <i class="fas fa-user-plus me-1"></i> Assign
                                                </button>
                                            </td>
                                        </tr>
                                    <% }) %>
                                <% } %>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <!-- Pending Approvals (Closure / Court Transfer) -->
        <div class="col-lg-5">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                    <h5 class="card-title mb-0 fw-bold text-dark">
                        <i class="fas fa-tasks text-info me-2"></i>Pending Approvals
                    </h5>
                    <span class="badge bg-info text-dark"><%= pendingApprovals.length %> Action Needed</span>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Case</th>
                                    <th>Requested Target</th>
                                    <th>Investigator</th>
                                    <th class="text-end">Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% if (pendingApprovals.length === 0) { %>
                                    <tr>
                                        <td colspan="4" class="text-center py-4 text-muted">
                                            <i class="fas fa-clipboard-check text-muted fs-4 d-block mb-2"></i>
                                            No status change approvals pending review.
                                        </td>
                                    </tr>
                                <% } else { %>
                                    <% pendingApprovals.forEach(item => { %>
                                        <tr>
                                            <td>
                                                <div class="fw-bold text-dark">#<%= item.case_number %></div>
                                                <small class="text-muted d-block text-truncate" style="max-width: 140px;"><%= item.title %></small>
                                            </td>
                                            <td>
                                                <% if (item.status === 'PENDING_CLOSURE') { %>
                                                    <span class="badge bg-warning text-dark"><i class="fas fa-lock me-1"></i> Closure</span>
                                                <% } else if (item.status === 'PENDING_COURT_TRANSFER') { %>
                                                    <span class="badge bg-info text-dark"><i class="fas fa-gavel me-1"></i> Court</span>
                                                <% } %>
                                            </td>
                                            <td><small class="fw-semibold"><%= item.investigator_name %></small></td>
                                            <td class="text-end">
                                                <button type="button" 
                                                        class="btn btn-sm btn-outline-dark btn-approval"
                                                        data-bs-toggle="modal" 
                                                        data-bs-target="#approvalModal"
                                                        data-case-id="<%= item.id %>"
                                                        data-case-ref="<%= item.case_number %>"
                                                        data-requested-status="<%= item.status %>">
                                                    Review
                                                </button>
                                            </td>
                                        </tr>
                                    <% }) %>
                                <% } %>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

    </div>

    <!-- Active Investigator Workload Tracking -->
    <div class="row">
        <div class="col-12">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-white py-3">
                    <h5 class="card-title mb-0 fw-bold text-dark">
                        <i class="fas fa-users-cog text-secondary me-2"></i>Investigator Active Workload Summary
                    </h5>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Badge Number</th>
                                    <th>Officer Name</th>
                                    <th>Rank</th>
                                    <th>Active Load</th>
                                    <th>Capacity Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% if (investigatorWorkload.length === 0) { %>
                                    <tr>
                                        <td colspan="5" class="text-center py-3 text-muted">No active investigators found.</td>
                                    </tr>
                                <% } else { %>
                                    <% investigatorWorkload.forEach(officer => { %>
                                        <tr>
                                            <td class="fw-bold"><%= officer.badge_number %></td>
                                            <td><%= officer.first_name %> <%= officer.last_name %></td>
                                            <td><span class="badge bg-light text-dark border"><%= officer.rank_title %></span></td>
                                            <td>
                                                <span class="fw-bold"><%= officer.active_case_count %></span> Active Cases
                                            </td>
                                            <td>
                                                <% if (officer.active_case_count === 0) { %>
                                                    <span class="badge bg-success">Available</span>
                                                <% } else if (officer.active_case_count <= 4) { %>
                                                    <span class="badge bg-info text-dark">Optimal Load</span>
                                                <% } else { %>
                                                    <span class="badge bg-danger">Heavy Workload</span>
                                                <% } %>
                                            </td>
                                        </tr>
                                    <% }) %>
                                <% } %>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>

</div>

<!-- ========================================== -->
<!-- MODAL 1: ASSIGN CASE TO INVESTIGATOR       -->
<!-- ========================================== -->
<div class="modal fade" id="assignModal" tabindex="-1" aria-labelledby="assignModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title fw-bold" id="assignModalLabel">Assign Case to Investigator</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form action="/supervisor/cases/assign" method="POST">
                <div class="modal-body">
                    <input type="hidden" name="case_id" id="modal_assign_case_id">
                    
                    <div class="mb-3">
                        <label class="form-label text-muted small fw-bold">CASE REFERENCE</label>
                        <div id="modal_assign_case_ref" class="form-control-plaintext fw-bold text-primary"></div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label text-muted small fw-bold">CASE TITLE</label>
                        <div id="modal_assign_case_title" class="form-control-plaintext text-dark"></div>
                    </div>

                    <div class="mb-3">
                        <label for="investigator_id" class="form-label fw-bold">Select Active Investigator <span class="text-danger">*</span></label>
                        <select name="investigator_id" id="investigator_id" class="form-select" required>
                            <option value="" disabled selected>-- Select Investigator --</option>
                            <% investigatorWorkload.forEach(inv => { %>
                                <option value="<%= inv.id %>">
                                    <%= inv.rank_title %> <%= inv.first_name %> <%= inv.last_name %> (<%= inv.badge_number %>) — [Current Load: <%= inv.active_case_count %>]
                                </option>
                            <% }) %>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label for="assign_notes" class="form-label fw-bold">Assignment Instructions / Notes</label>
                        <textarea name="notes" id="assign_notes" rows="3" class="form-control" placeholder="Optional directive notes for the lead detective..."></textarea>
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary"><i class="fas fa-check me-1"></i> Confirm Assignment</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- ========================================== -->
<!-- MODAL 2: PROCESS STATUS APPROVAL           -->
<!-- ========================================== -->
<div class="modal fade" id="approvalModal" tabindex="-1" aria-labelledby="approvalModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-dark text-white">
                <h5 class="modal-title fw-bold" id="approvalModalLabel">Review Status Change Request</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form action="/supervisor/cases/approve-status" method="POST">
                <div class="modal-body">
                    <input type="hidden" name="case_id" id="modal_approval_case_id">

                    <div class="mb-3">
                        <label class="form-label text-muted small fw-bold">CASE REFERENCE</label>
                        <div id="modal_approval_case_ref" class="form-control-plaintext fw-bold text-primary"></div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label text-muted small fw-bold">REQUESTED TRANSITION</label>
                        <div id="modal_approval_target_status" class="form-control-plaintext fw-bold text-dark"></div>
                    </div>

                    <div class="mb-3">
                        <label for="decision" class="form-label fw-bold">Supervisor Decision <span class="text-danger">*</span></label>
                        <select name="decision" id="decision" class="form-select" required>
                            <option value="APPROVE" class="text-success fw-bold">✅ Approve Request</option>
                            <option value="REJECT" class="text-danger fw-bold">❌ Reject Request (Return to Investigation)</option>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label for="supervisor_notes" class="form-label fw-bold">Supervisor Review Notes</label>
                        <textarea name="supervisor_notes" id="supervisor_notes" rows="3" class="form-control" placeholder="Provide reasons or directives regarding this decision..."></textarea>
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-dark"><i class="fas fa-paper-plane me-1"></i> Submit Decision</button>
                </div>
            </form>
        </div>
    </div>
</div>

<%- include('../partials/footer') %>

<!-- Client-side Script to handle Dynamic Modal Data Binding -->
<script>
    document.addEventListener('DOMContentLoaded', () => {
        // Modal 1: Assign Case Data Population
        const assignButtons = document.querySelectorAll('.btn-assign');
        assignButtons.forEach(btn => {
            btn.addEventListener('click', function () {
                const caseId = this.getAttribute('data-case-id');
                const caseRef = this.getAttribute('data-case-ref');
                const caseTitle = this.getAttribute('data-case-title');

                document.getElementById('modal_assign_case_id').value = caseId;
                document.getElementById('modal_assign_case_ref').textContent = '#' + caseRef;
                document.getElementById('modal_assign_case_title').textContent = caseTitle;
            });
        });

        // Modal 2: Approval Review Data Population
        const approvalButtons = document.querySelectorAll('.btn-approval');
        approvalButtons.forEach(btn => {
            btn.addEventListener('click', function () {
                const caseId = this.getAttribute('data-case-id');
                const caseRef = this.getAttribute('data-case-ref');
                const reqStatus = this.getAttribute('data-requested-status');

                document.getElementById('modal_approval_case_id').value = caseId;
                document.getElementById('modal_approval_case_ref').textContent = '#' + caseRef;
                
                let readableStatus = reqStatus === 'PENDING_CLOSURE' ? 'Close Case (CLOSED)' : 'Transfer to Court (IN_COURT)';
                document.getElementById('modal_approval_target_status').textContent = readableStatus;
            });
        });
    });
</script>