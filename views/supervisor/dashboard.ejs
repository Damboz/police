<%- include('../partials/header') %>

<div class="app-wrapper">
    <%- include('../partials/sidebar') %>

    <div class="main-content">
        <%- include('../partials/topbar') %>

        <div class="container-fluid py-4">

            <!-- Page Header -->
            <div class="d-flex align-items-center justify-content-between mb-4 flex-wrap gap-2">
                <div>
                    <h4 class="fw-bold mb-1" style="color: var(--mps-navy);">
                        <i class="bi bi-clipboard-data-fill me-2 text-warning"></i>Supervisor Command Dashboard
                    </h4>
                    <p class="text-muted small mb-0">Station operational oversight, case distribution, and status approvals.</p>
                </div>
                <div class="d-flex gap-2 flex-wrap">
                    <a href="/supervisor/analytics" class="btn btn-outline-navy btn-sm">
                        <i class="bi bi-graph-up-arrow me-1"></i>Analytics & Hotspots
                    </a>
                    <div class="dropdown">
                        <button class="btn btn-navy btn-sm dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                            <i class="bi bi-file-earmark-pdf-fill me-1"></i>Export Reports
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end shadow-sm">
                            <li><a class="dropdown-item small" href="/supervisor/reports/station-performance"><i class="bi bi-bar-chart-line me-2"></i>Station Performance</a></li>
                            <li><a class="dropdown-item small" href="/supervisor/reports/crime-statistics"><i class="bi bi-graph-up me-2"></i>Crime Statistics</a></li>
                            <li><a class="dropdown-item small" href="/supervisor/reports/officer-productivity"><i class="bi bi-person-lines-fill me-2"></i>Officer Productivity</a></li>
                        </ul>
                    </div>
                </div>
            </div>

            <!-- Flash Alert Messages -->
            <% if (typeof success !== 'undefined' && success && success.length > 0) { %>
                <div class="alert alert-success alert-dismissible fade show small mb-4" role="alert">
                    <i class="bi bi-check-circle-fill me-2"></i><%= success %>
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            <% } %>

            <% if (typeof error !== 'undefined' && error && error.length > 0) { %>
                <div class="alert alert-danger alert-dismissible fade show small mb-4" role="alert">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i><%= error %>
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            <% } %>

            <!-- KPI Summary Cards -->
            <div class="row g-3 mb-4">
                <div class="col-12 col-sm-6 col-xl-3">
                    <div class="card border-0 shadow-sm p-3">
                        <div class="metric-card">
                            <div>
                                <span class="text-muted small fw-semibold text-uppercase d-block mb-1">Unassigned Cases</span>
                                <h3 class="fw-bold mb-0" style="color: var(--mps-warning);"><%= kpi.unassigned %></h3>
                            </div>
                            <div class="metric-icon warning">
                                <i class="bi bi-folder2-open"></i>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-12 col-sm-6 col-xl-3">
                    <div class="card border-0 shadow-sm p-3">
                        <div class="metric-card">
                            <div>
                                <span class="text-muted small fw-semibold text-uppercase d-block mb-1">Pending Approvals</span>
                                <h3 class="fw-bold mb-0" style="color: var(--mps-info);"><%= kpi.pendingApprovals %></h3>
                            </div>
                            <div class="metric-icon navy">
                                <i class="bi bi-clipboard-check-fill"></i>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-12 col-sm-6 col-xl-3">
                    <div class="card border-0 shadow-sm p-3">
                        <div class="metric-card">
                            <div>
                                <span class="text-muted small fw-semibold text-uppercase d-block mb-1">Active Investigations</span>
                                <h3 class="fw-bold mb-0" style="color: var(--mps-success);"><%= kpi.activeCases %></h3>
                            </div>
                            <div class="metric-icon success">
                                <i class="bi bi-search"></i>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-12 col-sm-6 col-xl-3">
                    <div class="card border-0 shadow-sm p-3">
                        <div class="metric-card">
                            <div>
                                <span class="text-muted small fw-semibold text-uppercase d-block mb-1">Overdue (<%= overdueDaysThreshold %>+ days)</span>
                                <h3 class="fw-bold mb-0" style="color: var(--mps-danger);"><%= kpi.overdue %></h3>
                            </div>
                            <div class="metric-icon danger">
                                <i class="bi bi-alarm-fill"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Main Content Section: Unassigned Queue & Pending Approvals -->
            <div class="row g-4 mb-4">

                <!-- Unassigned Cases Queue -->
                <div class="col-lg-7">
                    <div class="card border-0 shadow-sm h-100">
                        <div class="card-header bg-navy text-white d-flex align-items-center justify-content-between py-3">
                            <h6 class="mb-0 fw-bold">
                                <i class="bi bi-exclamation-triangle-fill me-2 text-warning"></i>Unassigned Case Queue
                            </h6>
                            <span class="badge bg-gold text-dark"><%= unassignedCases.length %> Pending</span>
                        </div>
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead>
                                    <tr>
                                        <th>Case Ref</th>
                                        <th>Title & Category</th>
                                        <th>Priority</th>
                                        <th>Reg. Date</th>
                                        <th class="text-end">Action</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% if (unassignedCases.length === 0) { %>
                                        <tr>
                                            <td colspan="5" class="text-center py-4 text-muted">
                                                <i class="bi bi-check-circle-fill fs-4 d-block mb-2" style="color: var(--mps-success);"></i>
                                                All registered cases have been assigned!
                                            </td>
                                        </tr>
                                    <% } else { %>
                                        <% unassignedCases.forEach(item => { %>
                                            <tr>
                                                <td class="fw-bold font-monospace" style="color: var(--mps-navy);">#<%= item.case_number %></td>
                                                <td>
                                                    <div class="fw-semibold text-dark"><%= item.title %></div>
                                                    <small class="text-muted"><%= item.crime_category %></small>
                                                </td>
                                                <td>
                                                    <% if (item.priority === 'Critical') { %>
                                                        <span class="badge badge-priority-critical">CRITICAL</span>
                                                    <% } else if (item.priority === 'High') { %>
                                                        <span class="badge badge-priority-high">HIGH</span>
                                                    <% } else if (item.priority === 'Medium') { %>
                                                        <span class="badge badge-priority-medium">MEDIUM</span>
                                                    <% } else { %>
                                                        <span class="badge badge-priority-low">LOW</span>
                                                    <% } %>
                                                </td>
                                                <td class="small text-muted"><%= new Date(item.created_at).toLocaleDateString() %></td>
                                                <td class="text-end">
                                                    <button type="button"
                                                            class="btn btn-sm btn-navy btn-assign"
                                                            data-bs-toggle="modal"
                                                            data-bs-target="#assignModal"
                                                            data-mode="assign"
                                                            data-case-id="<%= item.id %>"
                                                            data-case-ref="<%= item.case_number %>"
                                                            data-case-title="<%= item.title %>">
                                                        <i class="bi bi-person-plus-fill me-1"></i>Assign
                                                    </button>
                                                </td>
                                            </tr>
                                        <% }) %>
                                    <% } %>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

                <!-- Pending Approvals (Closure / Court Transfer) -->
                <div class="col-lg-5">
                    <div class="card border-0 shadow-sm h-100">
                        <div class="card-header bg-navy text-white d-flex align-items-center justify-content-between py-3">
                            <h6 class="mb-0 fw-bold">
                                <i class="bi bi-list-task me-2 text-warning"></i>Pending Approvals
                            </h6>
                            <span class="badge bg-gold text-dark"><%= pendingApprovals.length %> Action Needed</span>
                        </div>
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead>
                                    <tr>
                                        <th>Case</th>
                                        <th>Requested Target</th>
                                        <th>Investigator</th>
                                        <th class="text-end">Action</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% if (pendingApprovals.length === 0) { %>
                                        <tr>
                                            <td colspan="4" class="text-center py-4 text-muted">
                                                <i class="bi bi-clipboard-check fs-4 d-block mb-2 text-muted"></i>
                                                No status change approvals pending review.
                                            </td>
                                        </tr>
                                    <% } else { %>
                                        <% pendingApprovals.forEach(item => { %>
                                            <tr>
                                                <td>
                                                    <div class="fw-bold" style="color: var(--mps-navy);">#<%= item.case_number %></div>
                                                    <small class="text-muted d-block text-truncate"><%= item.title %></small>
                                                </td>
                                                <td>
                                                    <% if (item.status === 'Closed') { %>
                                                        <span class="badge badge-case-closed"><i class="bi bi-lock-fill me-1"></i>Closure</span>
                                                    <% } else if (item.status === 'Court Pending') { %>
                                                        <span class="badge badge-case-investigation"><i class="bi bi-bank2 me-1"></i>Court</span>
                                                    <% } %>
                                                </td>
                                                <td><small class="fw-semibold"><%= item.investigator_name %></small></td>
                                                <td class="text-end">
                                                    <button type="button"
                                                            class="btn btn-sm btn-outline-navy btn-approval"
                                                            data-bs-toggle="modal"
                                                            data-bs-target="#approvalModal"
                                                            data-case-id="<%= item.id %>"
                                                            data-case-ref="<%= item.case_number %>"
                                                            data-requested-status="<%= item.status %>">
                                                        Review
                                                    </button>
                                                </td>
                                            </tr>
                                        <% }) %>
                                    <% } %>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

            </div>

            <!-- Active Assigned Cases (Reassignment + Overdue Visibility) -->
            <div class="row mb-4">
                <div class="col-12">
                    <div class="card border-0 shadow-sm">
                        <div class="card-header bg-navy text-white d-flex align-items-center justify-content-between py-3">
                            <h6 class="mb-0 fw-bold">
                                <i class="bi bi-arrow-left-right me-2 text-warning"></i>Active Assigned Cases
                            </h6>
                            <span class="badge bg-gold text-dark"><%= assignedActiveCases.length %> Active</span>
                        </div>
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead>
                                    <tr>
                                        <th>Case Ref</th>
                                        <th>Title & Category</th>
                                        <th>Priority</th>
                                        <th>Assigned Investigator</th>
                                        <th>Days Open</th>
                                        <th class="text-end">Action</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% if (assignedActiveCases.length === 0) { %>
                                        <tr>
                                            <td colspan="6" class="text-center py-4 text-muted">No active assigned cases at this time.</td>
                                        </tr>
                                    <% } else { %>
                                        <% assignedActiveCases.forEach(item => { %>
                                            <tr>
                                                <td class="fw-bold font-monospace" style="color: var(--mps-navy);">#<%= item.case_number %></td>
                                                <td>
                                                    <div class="fw-semibold text-dark"><%= item.title %></div>
                                                    <small class="text-muted"><%= item.crime_category %></small>
                                                </td>
                                                <td>
                                                    <% if (item.priority === 'Critical') { %>
                                                        <span class="badge badge-priority-critical">CRITICAL</span>
                                                    <% } else if (item.priority === 'High') { %>
                                                        <span class="badge badge-priority-high">HIGH</span>
                                                    <% } else if (item.priority === 'Medium') { %>
                                                        <span class="badge badge-priority-medium">MEDIUM</span>
                                                    <% } else { %>
                                                        <span class="badge badge-priority-low">LOW</span>
                                                    <% } %>
                                                </td>
                                                <td class="small fw-semibold"><%= item.investigator_name %></td>
                                                <td>
                                                    <% if (item.status === 'Under Investigation' && item.days_open > overdueDaysThreshold) { %>
                                                        <span class="badge badge-priority-critical"><i class="bi bi-alarm-fill me-1"></i><%= item.days_open %> days</span>
                                                    <% } else { %>
                                                        <span class="text-muted small"><%= item.days_open %> days</span>
                                                    <% } %>
                                                </td>
                                                <td class="text-end">
                                                    <button type="button"
                                                            class="btn btn-sm btn-outline-navy btn-assign"
                                                            data-bs-toggle="modal"
                                                            data-bs-target="#assignModal"
                                                            data-mode="reassign"
                                                            data-case-id="<%= item.id %>"
                                                            data-case-ref="<%= item.case_number %>"
                                                            data-case-title="<%= item.title %>"
                                                            data-current-investigator="<%= item.investigator_id %>">
                                                        <i class="bi bi-arrow-repeat me-1"></i>Reassign
                                                    </button>
                                                </td>
                                            </tr>
                                        <% }) %>
                                    <% } %>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Active Investigator Workload Tracking -->
            <div class="row">
                <div class="col-12">
                    <div class="card border-0 shadow-sm">
                        <div class="card-header bg-navy text-white py-3">
                            <h6 class="mb-0 fw-bold">
                                <i class="bi bi-people-fill me-2 text-warning"></i>Investigator Active Workload Summary
                            </h6>
                        </div>
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead>
                                    <tr>
                                        <th>Badge Number</th>
                                        <th>Officer Name</th>
                                        <th>Rank</th>
                                        <th>Active Load</th>
                                        <th>Capacity Status</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% if (investigatorWorkload.length === 0) { %>
                                        <tr>
                                            <td colspan="5" class="text-center py-3 text-muted">No active investigators found.</td>
                                        </tr>
                                    <% } else { %>
                                        <% investigatorWorkload.forEach(officer => { %>
                                            <tr>
                                                <td class="fw-bold font-monospace small"><%= officer.badge_number %></td>
                                                <td><%= officer.first_name %> <%= officer.last_name %></td>
                                                <td><span class="badge bg-light text-dark border"><%= officer.rank_title %></span></td>
                                                <td>
                                                    <span class="fw-bold"><%= officer.active_case_count %></span> Active Cases
                                                </td>
                                                <td>
                                                    <% if (officer.active_case_count === 0) { %>
                                                        <span class="badge badge-case-closed">Available</span>
                                                    <% } else if (officer.active_case_count <= 4) { %>
                                                        <span class="badge badge-case-open">Optimal Load</span>
                                                    <% } else { %>
                                                        <span class="badge badge-priority-critical">Heavy Workload</span>
                                                    <% } %>
                                                </td>
                                            </tr>
                                        <% }) %>
                                    <% } %>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>

<!-- ========================================== -->
<!-- MODAL 1: ASSIGN / REASSIGN CASE            -->
<!-- ========================================== -->
<div class="modal fade" id="assignModal" tabindex="-1" aria-labelledby="assignModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-navy text-white">
                <h5 class="modal-title fw-bold" id="assignModalLabel">Assign Case to Investigator</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form action="/supervisor/cases/assign" method="POST">
                <div class="modal-body">
                    <input type="hidden" name="case_id" id="modal_assign_case_id">

                    <div class="mb-3">
                        <label class="form-label">CASE REFERENCE</label>
                        <div id="modal_assign_case_ref" class="form-control-plaintext fw-bold"></div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">CASE TITLE</label>
                        <div id="modal_assign_case_title" class="form-control-plaintext text-dark"></div>
                    </div>

                    <div class="mb-3" id="modal_current_investigator_wrapper" style="display: none;">
                        <label class="form-label">CURRENTLY ASSIGNED TO</label>
                        <div id="modal_current_investigator" class="form-control-plaintext text-muted"></div>
                    </div>

                    <div class="mb-3">
                        <label for="investigator_id" class="form-label">Select Active Investigator <span class="text-danger">*</span></label>
                        <select name="investigator_id" id="investigator_id" class="form-select" required>
                            <option value="" disabled selected>-- Select Investigator --</option>
                            <% investigatorWorkload.forEach(inv => { %>
                                <option value="<%= inv.id %>">
                                    <%= inv.rank_title %> <%= inv.first_name %> <%= inv.last_name %> (<%= inv.badge_number %>) — [Current Load: <%= inv.active_case_count %>]
                                </option>
                            <% }) %>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label for="assign_notes" class="form-label">Assignment Instructions / Notes</label>
                        <textarea name="notes" id="assign_notes" rows="3" class="form-control" placeholder="Optional directive notes for the lead detective..."></textarea>
                    </div>
                </div>
                <div class="modal-footer" style="background-color: var(--mps-bg-subtle);">
                    <button type="button" class="btn btn-outline-navy" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-navy" id="modal_assign_submit_btn"><i class="bi bi-check-lg me-1"></i>Confirm Assignment</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- ========================================== -->
<!-- MODAL 2: PROCESS STATUS APPROVAL           -->
<!-- ========================================== -->
<div class="modal fade" id="approvalModal" tabindex="-1" aria-labelledby="approvalModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-navy text-white">
                <h5 class="modal-title fw-bold" id="approvalModalLabel">Review Status Change Request</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form action="/supervisor/cases/approve-status" method="POST">
                <div class="modal-body">
                    <input type="hidden" name="case_id" id="modal_approval_case_id">

                    <div class="mb-3">
                        <label class="form-label">CASE REFERENCE</label>
                        <div id="modal_approval_case_ref" class="form-control-plaintext fw-bold"></div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">REQUESTED TRANSITION</label>
                        <div id="modal_approval_target_status" class="form-control-plaintext fw-bold text-dark"></div>
                    </div>

                    <div class="mb-3">
                        <label for="decision" class="form-label">Supervisor Decision <span class="text-danger">*</span></label>
                        <select name="decision" id="decision" class="form-select" required>
                            <option value="APPROVE">Approve Request</option>
                            <option value="REJECT">Reject Request (Return to Investigation)</option>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label for="supervisor_notes" class="form-label">Supervisor Review Notes</label>
                        <textarea name="supervisor_notes" id="supervisor_notes" rows="3" class="form-control" placeholder="Provide reasons or directives regarding this decision..."></textarea>
                    </div>
                </div>
                <div class="modal-footer" style="background-color: var(--mps-bg-subtle);">
                    <button type="button" class="btn btn-outline-navy" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-navy"><i class="bi bi-send-fill me-1"></i>Submit Decision</button>
                </div>
            </form>
        </div>
    </div>
</div>

<%- include('../partials/footer') %>

<!-- Client-side Script to handle Dynamic Modal Data Binding -->
<script>
    document.addEventListener('DOMContentLoaded', () => {
        // Modal 1: Assign / Reassign Case Data Population
        const assignButtons = document.querySelectorAll('.btn-assign');
        const assignModalLabel = document.getElementById('assignModalLabel');
        const assignSubmitBtn = document.getElementById('modal_assign_submit_btn');
        const currentInvestigatorWrapper = document.getElementById('modal_current_investigator_wrapper');
        const currentInvestigatorField = document.getElementById('modal_current_investigator');

        assignButtons.forEach(btn => {
            btn.addEventListener('click', function () {
                const mode = this.getAttribute('data-mode') || 'assign';
                const caseId = this.getAttribute('data-case-id');
                const caseRef = this.getAttribute('data-case-ref');
                const caseTitle = this.getAttribute('data-case-title');
                const currentInvestigatorId = this.getAttribute('data-current-investigator');

                document.getElementById('modal_assign_case_id').value = caseId;
                document.getElementById('modal_assign_case_ref').textContent = '#' + caseRef;
                document.getElementById('modal_assign_case_title').textContent = caseTitle;

                if (mode === 'reassign') {
                    assignModalLabel.textContent = 'Reassign Case to Investigator';
                    assignSubmitBtn.innerHTML = '<i class="bi bi-arrow-repeat me-1"></i>Confirm Reassignment';
                    currentInvestigatorWrapper.style.display = 'block';

                    const currentOption = document.querySelector(`#investigator_id option[value="${currentInvestigatorId}"]`);
                    currentInvestigatorField.textContent = currentOption ? currentOption.textContent.trim() : 'Unknown Officer';
                } else {
                    assignModalLabel.textContent = 'Assign Case to Investigator';
                    assignSubmitBtn.innerHTML = '<i class="bi bi-check-lg me-1"></i>Confirm Assignment';
                    currentInvestigatorWrapper.style.display = 'none';
                }
            });
        });

        // Modal 2: Approval Review Data Population
        const approvalButtons = document.querySelectorAll('.btn-approval');
        approvalButtons.forEach(btn => {
            btn.addEventListener('click', function () {
                const caseId = this.getAttribute('data-case-id');
                const caseRef = this.getAttribute('data-case-ref');
                const reqStatus = this.getAttribute('data-requested-status');

                document.getElementById('modal_approval_case_id').value = caseId;
                document.getElementById('modal_approval_case_ref').textContent = '#' + caseRef;

                let readableStatus = reqStatus === 'Closed' ? 'Close Case (CLOSED)' : 'Transfer to Court (COURT PENDING)';
                document.getElementById('modal_approval_target_status').textContent = readableStatus;
            });
        });
    });
</script>
