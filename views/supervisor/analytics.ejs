<%- include('../partials/header') %>
<%- include('../partials/sidebar') %>

<div class="container-fluid py-4">
    <!-- Page Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 mb-0 text-gray-800">Crime Trend Analytics & Hotspots</h1>
            <p class="text-muted small mb-0">Station crime intelligence, temporal trends, and geographical hotspot tracking</p>
        </div>
        <div>
            <button onclick="window.print()" class="btn btn-outline-secondary btn-sm me-2">
                <i class="fas fa-print me-1"></i> Print Report
            </button>
            <span class="badge bg-primary px-3 py-2">Station: Limbe Central</span>
        </div>
    </div>

    <!-- Summary KPI Cards -->
    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="card border-0 border-start border-4 border-primary shadow-sm h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <div class="text-uppercase text-muted fw-bold small">Total Registered Cases</div>
                            <div class="h2 mb-0 fw-bold text-dark"><%= metrics.totalCases %></div>
                        </div>
                        <div class="rounded-circle bg-primary bg-opacity-10 p-3 text-primary fs-3">
                            <i class="fas fa-balance-scale"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card border-0 border-start border-4 border-success shadow-sm h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <div class="text-uppercase text-muted fw-bold small">Resolved Cases</div>
                            <div class="h2 mb-0 fw-bold text-dark"><%= metrics.closedCases %></div>
                        </div>
                        <div class="rounded-circle bg-success bg-opacity-10 p-3 text-success fs-3">
                            <i class="fas fa-check-circle"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card border-0 border-start border-4 border-info shadow-sm h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <div class="text-uppercase text-muted fw-bold small">Overall Resolution Rate</div>
                            <div class="h2 mb-0 fw-bold text-dark"><%= metrics.resolutionRate %>%</div>
                        </div>
                        <div class="rounded-circle bg-info bg-opacity-10 p-3 text-info fs-3">
                            <i class="fas fa-chart-line"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Charts Row 1: Monthly Trends & Category Breakdown -->
    <div class="row g-4 mb-4">
        <!-- 12-Month Incident Trend Line Chart -->
        <div class="col-lg-8">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                    <h5 class="card-title mb-0 fw-bold text-dark">
                        <i class="fas fa-chart-area text-primary me-2"></i>12-Month Crime Incident Trend
                    </h5>
                    <span class="badge bg-light text-dark border">Volume vs Severe Cases</span>
                </div>
                <div class="card-body">
                    <div style="height: 320px; position: relative;">
                        <canvas id="monthlyTrendChart"></canvas>
                    </div>
                </div>
            </div>
        </div>

        <!-- Crime Category Doughnut Chart -->
        <div class="col-lg-4">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-header bg-white py-3">
                    <h5 class="card-title mb-0 fw-bold text-dark">
                        <i class="fas fa-chart-pie text-secondary me-2"></i>Crime Category Distribution
                    </h5>
                </div>
                <div class="card-body d-flex align-items-center justify-content-center">
                    <div style="height: 280px; width: 100%; position: relative;">
                        <canvas id="categoryChart"></canvas>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Row 2: Top Hotspots Table & Status Breakdown Chart -->
    <div class="row g-4 mb-4">
        <!-- Hotspot Analysis Table -->
        <div class="col-lg-7">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                    <h5 class="card-title mb-0 fw-bold text-dark">
                        <i class="fas fa-map-marker-alt text-danger me-2"></i>Top Incident Hotspots
                    </h5>
                    <span class="badge bg-danger bg-opacity-10 text-danger border border-danger">High Activity Zones</span>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Location / Zone</th>
                                    <th class="text-center">Total Incidents</th>
                                    <th class="text-center">Active</th>
                                    <th class="text-center">Resolved</th>
                                    <th style="width: 25%;">Resolution Ratio</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% if (hotspots.length === 0) { %>
                                    <tr>
                                        <td colspan="5" class="text-center py-4 text-muted">No location hotspot data registered yet.</td>
                                    </tr>
                                <% } else { %>
                                    <% hotspots.forEach(spot => { 
                                        const total = spot.incident_count || 0;
                                        const resolved = spot.resolved_count || 0;
                                        const pct = total > 0 ? Math.round((resolved / total) * 100) : 0;
                                    %>
                                        <tr>
                                            <td class="fw-bold text-dark">
                                                <i class="fas fa-map-pin text-muted me-1"></i><%= spot.location %>
                                            </td>
                                            <td class="text-center fw-bold"><%= spot.incident_count %></td>
                                            <td class="text-center"><span class="badge bg-warning text-dark"><%= spot.active_count %></span></td>
                                            <td class="text-center"><span class="badge bg-success"><%= spot.resolved_count %></span></td>
                                            <td>
                                                <div class="d-flex align-items-center">
                                                    <div class="progress flex-grow-1 me-2" style="height: 8px;">
                                                        <div class="progress-bar bg-success" role="progressbar" style="width: <%= pct %>%" aria-valuenow="<%= pct %>" aria-valuemin="0" aria-valuemax="100"></div>
                                                    </div>
                                                    <small class="fw-bold text-muted"><%= pct %>%</small>
                                                </div>
                                            </td>
                                        </tr>
                                    <% }) %>
                                <% } %>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <!-- Case Status Breakdown Pie Chart -->
        <div class="col-lg-5">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-header bg-white py-3">
                    <h5 class="card-title mb-0 fw-bold text-dark">
                        <i class="fas fa-tasks text-info me-2"></i>Case Status Breakdown
                    </h5>
                </div>
                <div class="card-body d-flex align-items-center justify-content-center">
                    <div style="height: 280px; width: 100%; position: relative;">
                        <canvas id="statusChart"></canvas>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<%- include('../partials/footer') %>

<!-- Chart.js Library CDN -->
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<!-- Client-side Chart Initialization Script -->
<script>
    document.addEventListener('DOMContentLoaded', () => {
        // Server data safely converted into Client-side Objects
        const monthlyTrends = <%- JSON.stringify(monthlyTrends) %>;
        const categoryBreakdown = <%- JSON.stringify(categoryBreakdown) %>;
        const statusDistribution = <%- JSON.stringify(statusDistribution) %>;

        // 1. Monthly Trend Line Chart
        const trendCtx = document.getElementById('monthlyTrendChart').getContext('2d');
        new Chart(trendCtx, {
            type: 'line',
            data: {
                labels: monthlyTrends.map(item => item.month_label),
                datasets: [
                    {
                        label: 'Total Incidents',
                        data: monthlyTrends.map(item => item.total_cases),
                        borderColor: '#0d6efd',
                        backgroundColor: 'rgba(13, 110, 253, 0.1)',
                        fill: true,
                        tension: 0.3,
                        borderWidth: 2,
                        pointRadius: 4
                    },
                    {
                        label: 'Severe Cases (High/Critical)',
                        data: monthlyTrends.map(item => item.severe_cases),
                        borderColor: '#dc3545',
                        backgroundColor: 'rgba(220, 53, 69, 0.1)',
                        fill: true,
                        tension: 0.3,
                        borderWidth: 2,
                        pointRadius: 4
                    }
                ]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { position: 'top' },
                    tooltip: { mode: 'index', intersect: false }
                },
                scales: {
                    y: {
                        beginAtZero: true,
                        ticks: { precision: 0 }
                    }
                }
            }
        });

        // 2. Crime Category Doughnut Chart
        const categoryCtx = document.getElementById('categoryChart').getContext('2d');
        new Chart(categoryCtx, {
            type: 'doughnut',
            data: {
                labels: categoryBreakdown.map(item => item.crime_category),
                datasets: [{
                    data: categoryBreakdown.map(item => item.total_incidents),
                    backgroundColor: [
                        '#0d6efd', '#6f42c1', '#d63384', '#fd7e14', '#ffc107',
                        '#198754', '#20c997', '#0dcaf0', '#6c757d'
                    ],
                    borderWidth: 2
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: {
                        position: 'bottom',
                        labels: { boxWidth: 12, font: { size: 11 } }
                    }
                }
            }
        });

        // 3. Status Breakdown Pie Chart
        const statusCtx = document.getElementById('statusChart').getContext('2d');
        const statusColorMap = {
            'REGISTERED': '#6c757d',
            'UNDER_INVESTIGATION': '#0dcaf0',
            'PENDING_CLOSURE': '#ffc107',
            'PENDING_COURT_TRANSFER': '#fd7e14',
            'IN_COURT': '#6f42c1',
            'CLOSED': '#198754'
        };

        new Chart(statusCtx, {
            type: 'pie',
            data: {
                labels: statusDistribution.map(item => item.status.replace(/_/g, ' ')),
                datasets: [{
                    data: statusDistribution.map(item => item.total_count),
                    backgroundColor: statusDistribution.map(item => statusColorMap[item.status] || '#adb5bd'),
                    borderWidth: 2
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: {
                        position: 'bottom',
                        labels: { boxWidth: 12, font: { size: 11 } }
                    }
                }
            }
        });
    });
</script>