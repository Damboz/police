<%- include('../partials/header') %>

<div class="app-wrapper">
    <%- include('../partials/sidebar') %>

    <div class="main-content">
        <%- include('../partials/topbar') %>

        <div class="container-fluid py-4">

            <!-- Page Header -->
            <div class="d-flex align-items-center justify-content-between mb-4 flex-wrap gap-2">
                <div>
                    <h4 class="fw-bold mb-1" style="color: var(--mps-navy);">
                        <i class="bi bi-graph-up-arrow me-2 text-warning"></i>Crime Trend Analytics & Hotspots
                    </h4>
                    <p class="text-muted small mb-0">Category distributions, monthly trends, and hotspot analysis for resource deployment.</p>
                </div>
                <div class="d-flex gap-2 flex-wrap">
                    <a href="/supervisor/dashboard" class="btn btn-outline-navy btn-sm">
                        <i class="bi bi-arrow-left me-1"></i>Back to Dashboard
                    </a>
                    <a href="/supervisor/reports/crime-statistics" class="btn btn-navy btn-sm">
                        <i class="bi bi-file-earmark-pdf-fill me-1"></i>Export PDF
                    </a>
                </div>
            </div>

            <!-- Metric Summary Cards -->
            <div class="row g-3 mb-4">
                <div class="col-12 col-sm-6 col-xl-4">
                    <div class="card border-0 shadow-sm p-3">
                        <div class="metric-card">
                            <div>
                                <span class="text-muted small fw-semibold text-uppercase d-block mb-1">Total Cases Recorded</span>
                                <h3 class="fw-bold mb-0" style="color: var(--mps-navy);"><%= metrics.totalCases %></h3>
                            </div>
                            <div class="metric-icon navy">
                                <i class="bi bi-folder-fill"></i>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-12 col-sm-6 col-xl-4">
                    <div class="card border-0 shadow-sm p-3">
                        <div class="metric-card">
                            <div>
                                <span class="text-muted small fw-semibold text-uppercase d-block mb-1">Closed Cases</span>
                                <h3 class="fw-bold mb-0" style="color: var(--mps-success);"><%= metrics.closedCases %></h3>
                            </div>
                            <div class="metric-icon success">
                                <i class="bi bi-check-circle-fill"></i>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-12 col-sm-6 col-xl-4">
                    <div class="card border-0 shadow-sm p-3">
                        <div class="metric-card">
                            <div>
                                <span class="text-muted small fw-semibold text-uppercase d-block mb-1">Resolution Rate</span>
                                <h3 class="fw-bold mb-0" style="color: var(--mps-blue);"><%= metrics.resolutionRate %>%</h3>
                            </div>
                            <div class="metric-icon blue">
                                <i class="bi bi-speedometer2"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Charts Row: Monthly Trend + Status Distribution -->
            <div class="row g-4 mb-4">
                <div class="col-lg-8">
                    <div class="card border-0 shadow-sm h-100">
                        <div class="card-header bg-navy text-white py-3">
                            <h6 class="mb-0 fw-bold">
                                <i class="bi bi-bar-chart-line-fill me-2 text-warning"></i>Monthly Case Volume (Last 12 Months)
                            </h6>
                        </div>
                        <div class="card-body">
                            <canvas id="monthlyTrendChart" height="110"></canvas>
                        </div>
                    </div>
                </div>

                <div class="col-lg-4">
                    <div class="card border-0 shadow-sm h-100">
                        <div class="card-header bg-navy text-white py-3">
                            <h6 class="mb-0 fw-bold">
                                <i class="bi bi-pie-chart-fill me-2 text-warning"></i>Status Distribution
                            </h6>
                        </div>
                        <div class="card-body d-flex align-items-center justify-content-center">
                            <canvas id="statusDistributionChart"></canvas>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Category Breakdown + Hotspots -->
            <div class="row g-4 mb-4">
                <div class="col-lg-6">
                    <div class="card border-0 shadow-sm h-100">
                        <div class="card-header bg-navy text-white py-3">
                            <h6 class="mb-0 fw-bold">
                                <i class="bi bi-tags-fill me-2 text-warning"></i>Crime Category Breakdown
                            </h6>
                        </div>
                        <div class="card-body">
                            <canvas id="categoryBreakdownChart" height="220"></canvas>
                        </div>
                        <div class="table-responsive">
                            <table class="table table-sm align-middle mb-0">
                                <thead>
                                    <tr>
                                        <th>Category</th>
                                        <th class="text-end">Incidents</th>
                                        <th class="text-end">Share</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% categoryBreakdown.forEach(cat => { %>
                                        <tr>
                                            <td class="small"><%= cat.crime_category %></td>
                                            <td class="text-end small fw-semibold"><%= cat.total_incidents %></td>
                                            <td class="text-end small text-muted"><%= cat.percentage || 0 %>%</td>
                                        </tr>
                                    <% }) %>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

                <div class="col-lg-6">
                    <div class="card border-0 shadow-sm h-100">
                        <div class="card-header bg-navy text-white d-flex align-items-center justify-content-between py-3">
                            <h6 class="mb-0 fw-bold">
                                <i class="bi bi-geo-alt-fill me-2 text-warning"></i>Top Incident Hotspots
                            </h6>
                            <span class="badge bg-gold text-dark">Top <%= hotspots.length %></span>
                        </div>
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead>
                                    <tr>
                                        <th>Location</th>
                                        <th class="text-end">Incidents</th>
                                        <th class="text-end">Resolved</th>
                                        <th class="text-end">Active</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% if (hotspots.length === 0) { %>
                                        <tr>
                                            <td colspan="4" class="text-center py-4 text-muted">No location data available yet.</td>
                                        </tr>
                                    <% } else { %>
                                        <% hotspots.forEach((h, i) => { %>
                                            <tr>
                                                <td class="small">
                                                    <span class="badge bg-light text-dark border me-2"><%= i + 1 %></span>
                                                    <%= h.location %>
                                                </td>
                                                <td class="text-end fw-bold small"><%= h.incident_count %></td>
                                                <td class="text-end small" style="color: var(--mps-success);"><%= h.resolved_count %></td>
                                                <td class="text-end small" style="color: var(--mps-warning);"><%= h.active_count %></td>
                                            </tr>
                                        <% }) %>
                                    <% } %>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>

<%- include('../partials/footer') %>

<!-- Chart.js (loaded from CDN, consistent with the Bootstrap/Bootstrap Icons CDN pattern used in header.ejs) -->
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.4/dist/chart.umd.min.js"></script>

<script>
    document.addEventListener('DOMContentLoaded', () => {
        // Design system colors pulled to match style.css tokens
        const COLORS = {
            navy: 'rgb(2, 116, 176)',
            navyFill: 'rgba(2, 116, 176, 0.12)',
            gold: 'rgb(247, 198, 49)',
            success: 'rgb(22, 163, 74)',
            warning: 'rgb(234, 88, 12)',
            danger: 'rgb(220, 38, 38)',
            info: 'rgb(2, 132, 199)',
            slate: 'rgb(100, 116, 139)'
        };

        // ---- Monthly Trend Chart (Line) ----
        const monthlyLabels = <%- JSON.stringify(monthlyTrends.map(m => m.month_label)) %>;
        const monthlyTotals = <%- JSON.stringify(monthlyTrends.map(m => m.total_cases)) %>;
        const monthlySevere = <%- JSON.stringify(monthlyTrends.map(m => m.severe_cases)) %>;

        new Chart(document.getElementById('monthlyTrendChart'), {
            type: 'line',
            data: {
                labels: monthlyLabels,
                datasets: [
                    {
                        label: 'Total Cases',
                        data: monthlyTotals,
                        borderColor: COLORS.navy,
                        backgroundColor: COLORS.navyFill,
                        fill: true,
                        tension: 0.3,
                        pointRadius: 3
                    },
                    {
                        label: 'High / Critical Priority',
                        data: monthlySevere,
                        borderColor: COLORS.danger,
                        backgroundColor: 'transparent',
                        borderDash: [5, 4],
                        tension: 0.3,
                        pointRadius: 3
                    }
                ]
            },
            options: {
                responsive: true,
                plugins: { legend: { position: 'bottom', labels: { boxWidth: 12, font: { size: 11 } } } },
                scales: {
                    y: { beginAtZero: true, ticks: { precision: 0 } }
                }
            }
        });

        // ---- Status Distribution Chart (Doughnut) ----
        const statusLabels = <%- JSON.stringify(statusDistribution.map(s => s.status)) %>;
        const statusCounts = <%- JSON.stringify(statusDistribution.map(s => s.total_count)) %>;
        const statusColorMap = {
            'Reported': COLORS.info,
            'Under Investigation': COLORS.warning,
            'Court Pending': COLORS.navy,
            'Closed': COLORS.success,
            'Archived': COLORS.slate
        };

        new Chart(document.getElementById('statusDistributionChart'), {
            type: 'doughnut',
            data: {
                labels: statusLabels,
                datasets: [{
                    data: statusCounts,
                    backgroundColor: statusLabels.map(s => statusColorMap[s] || COLORS.slate),
                    borderWidth: 2,
                    borderColor: '#fff'
                }]
            },
            options: {
                responsive: true,
                plugins: { legend: { position: 'bottom', labels: { boxWidth: 12, font: { size: 10 } } } }
            }
        });

        // ---- Category Breakdown Chart (Horizontal Bar) ----
        const categoryLabels = <%- JSON.stringify(categoryBreakdown.map(c => c.crime_category)) %>;
        const categoryCounts = <%- JSON.stringify(categoryBreakdown.map(c => c.total_incidents)) %>;

        new Chart(document.getElementById('categoryBreakdownChart'), {
            type: 'bar',
            data: {
                labels: categoryLabels,
                datasets: [{
                    label: 'Incidents',
                    data: categoryCounts,
                    backgroundColor: COLORS.gold,
                    borderRadius: 4
                }]
            },
            options: {
                indexAxis: 'y',
                responsive: true,
                plugins: { legend: { display: false } },
                scales: {
                    x: { beginAtZero: true, ticks: { precision: 0 } }
                }
            }
        });
    });
</script>
