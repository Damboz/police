<% const user = locals.currentUser || (locals.session ? locals.session.user : null); %>

<header class="topbar">
    <!-- 1. Left System / Station Branding -->
    <div class="d-flex align-items-center gap-3">
        <div class="d-flex align-items-center gap-2">
            <i class="bi bi-building-shield text-muted fs-5 d-none d-md-inline"></i>
            <span class="fw-bold text-uppercase font-monospace text-muted small d-none d-md-inline" style="letter-spacing: 0.05em;">
                Malawi Police Service — Limbe Station
            </span>
        </div>
    </div>

    <!-- 2. Right Authenticated User Controls -->
    <div class="d-flex align-items-center gap-3">
        <% if (user) { %>
            <div class="dropdown">
                <a href="#" class="d-flex align-items-center gap-2 text-decoration-none dropdown-toggle py-1 px-2 rounded-2" id="userMenu" data-bs-toggle="dropdown" aria-expanded="false" style="transition: background-color 0.15s ease;">
                    <!-- User Initial Avatar -->
                    <div class="rounded-circle d-flex align-items-center justify-content-center fw-bold text-white shadow-sm" style="width: 36px; height: 36px; background-color: var(--mps-navy); font-size: 0.875rem;">
                        <%= user.first_name ? user.first_name.charAt(0).toUpperCase() : 'O' %>
                    </div>
                    
                    <!-- Officer Rank & Badge Number -->
                    <div class="text-start d-none d-sm-block">
                        <span class="fw-bold d-block lh-1 text-dark" style="font-size: 0.8125rem;">
                            <%= user.rank_title || 'Officer' %> <%= user.last_name %>
                        </span>
                        <small class="text-muted font-monospace d-block mt-1" style="font-size: 0.72rem;">
                            ID: <%= user.badge_number || 'N/A' %>
                        </small>
                    </div>
                </a>

                <!-- User Dropdown Menu -->
                <ul class="dropdown-menu dropdown-menu-end shadow-md border-0 mt-2 p-0 overflow-hidden" aria-labelledby="userMenu" style="min-width: 220px; border-radius: var(--mps-radius-md);">
                    <!-- User Profile Summary Header -->
                    <li class="p-3 bg-light border-bottom">
                        <div class="fw-bold text-dark mb-1" style="font-size: 0.875rem;">
                            <%= user.first_name %> <%= user.last_name %>
                        </div>
                        <span class="badge badge-case-open">
                            <%= user.role %>
                        </span>
                    </li>

                    <!-- Account Actions -->
                    <li class="pt-1">
                        <a class="dropdown-item py-2 px-3 d-flex align-items-center gap-2" href="/auth/change-password" style="font-size: 0.85rem;">
                            <i class="bi bi-key-fill text-warning"></i>
                            <span>Change Password</span>
                        </a>
                    </li>
                    
                    <li><hr class="dropdown-divider my-1"></li>
                    
                    <li class="pb-1">
                        <a class="dropdown-item py-2 px-3 text-danger d-flex align-items-center gap-2" href="/auth/logout" style="font-size: 0.85rem;">
                            <i class="bi bi-box-arrow-right"></i>
                            <span>Sign Out</span>
                        </a>
                    </li>
                </ul>
            </div>
        <% } else { %>
            <a href="/auth/login" class="btn btn-navy btn-sm px-3">
                <i class="bi bi-box-arrow-in-right me-1"></i> Sign In
            </a>
        <% } %>
    </div>
</header>