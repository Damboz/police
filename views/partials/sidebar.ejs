<% 
  const activeUser = locals.currentUser || (locals.session ? locals.session.user : null); 
  const currentPath = locals.currentPath || ''; 
  const role = activeUser ? activeUser.role : '';
%>

<aside class="sidebar">
    <!-- 1. Station Branding & Logo Block -->
    <div class="sidebar-brand d-flex align-items-center">
        <!-- Logo on the left corner -->
        <div class="sidebar-logo-container me-2">
            <img src="/logo/image.png" alt="Limbe Police Emblem" class="sidebar-logo">
        </div>
        <!-- Text details -->
        <div class="lh-sm">
            <div class="fw-bold text-white fs-6">Limbe Police Station</div>
            <small class="text-white-50 d-block" style="font-size: 0.7rem;">Case Management System</small>
        </div>
    </div>

    <!-- 2. Core Navigation Menu -->
    <ul class="sidebar-menu">
        <li class="sidebar-heading">Core Operations</li>

        <!-- Dashboard: every role lands here, backend redirects to their specific view -->
        <li>
            <a href="/dashboard" class="sidebar-link <%= (currentPath === '/dashboard' || currentPath === '/supervisor/dashboard' || currentPath === '/admin/dashboard') ? 'active' : '' %>">
                <i class="bi bi-speedometer2"></i>
                <span>Dashboard</span>
            </a>
        </li>

        <!-- Case Register: all four roles can register/view cases -->
        <li>
            <a href="/cases" class="sidebar-link <%= currentPath.startsWith('/cases') ? 'active' : '' %>">
                <i class="bi bi-folder2-open"></i>
                <span>Case Register</span>
            </a>
        </li>

        <!-- Evidence Ledger: Investigating Officer (assigned cases) & Station Commander (read-only oversight).
             Admin is intentionally excluded — casework tools are outside the System Administrator's role. -->
        <% if (role === 'Investigating Officer' || role === 'Station Commander') { %>
            <li>
                <a href="/evidence" class="sidebar-link <%= currentPath.startsWith('/evidence') ? 'active' : '' %>">
                    <i class="bi bi-box-seam"></i>
                    <span>Evidence Ledger</span>
                </a>
            </li>
        <% } %>

        <!-- Command & Oversight: Station Commander & Admin only -->
        <% if (role === 'Station Commander' || role === 'Admin') { %>
            <li class="sidebar-heading mt-3">Command & Oversight</li>

            <li>
                <a href="/supervisor/analytics" class="sidebar-link <%= currentPath.startsWith('/supervisor/analytics') ? 'active' : '' %>">
                    <i class="bi bi-graph-up-arrow"></i>
                    <span>Analytics & Hotspots</span>
                </a>
            </li>

            <li>
                <a href="/supervisor/reports/station-performance" class="sidebar-link">
                    <i class="bi bi-file-earmark-bar-graph"></i>
                    <span>Station Performance PDF</span>
                </a>
            </li>

            <li>
                <a href="/supervisor/reports/crime-statistics" class="sidebar-link">
                    <i class="bi bi-file-earmark-text"></i>
                    <span>Crime Statistics PDF</span>
                </a>
            </li>

            <li>
                <a href="/supervisor/reports/officer-productivity" class="sidebar-link">
                    <i class="bi bi-file-earmark-person"></i>
                    <span>Officer Productivity PDF</span>
                </a>
            </li>
        <% } %>

        <!-- System Administrator Operations: Admin only -->
        <% if (role === 'Admin') { %>
            <li class="sidebar-heading mt-3">Administration</li>
            
            <li>
                <a href="/admin/dashboard" class="sidebar-link <%= currentPath === '/admin/dashboard' ? 'active' : '' %>">
                    <i class="bi bi-shield-lock"></i>
                    <span>Admin Overview</span>
                </a>
            </li>

            <li>
                <a href="/admin/users" class="sidebar-link <%= currentPath.startsWith('/admin/users') ? 'active' : '' %>">
                    <i class="bi bi-people"></i>
                    <span>Personnel Accounts</span>
                </a>
            </li>

            <li>
                <a href="/admin/audit-logs" class="sidebar-link <%= currentPath.startsWith('/admin/audit-logs') ? 'active' : '' %>">
                    <i class="bi bi-journal-text"></i>
                    <span>Security Audit Logs</span>
                </a>
            </li>
        <% } %>

        <li class="sidebar-heading mt-3">Account</li>

        <!-- User Settings & Auth Controls: every role -->
        <li>
            <a href="/auth/change-password" class="sidebar-link <%= currentPath === '/auth/change-password' ? 'active' : '' %>">
                <i class="bi bi-key-fill text-warning"></i>
                <span>Change Password</span>
            </a>
        </li>

        <li>
            <a href="/auth/logout" class="sidebar-link text-danger">
                <i class="bi bi-box-arrow-right"></i>
                <span>Sign Out</span>
            </a>
        </li>
    </ul>

    <!-- 3. Sidebar Footer Info -->
    <div class="sidebar-footer">
        <% if (activeUser) { %>
            <div class="d-flex align-items-center mb-2">
                <div class="bg-secondary rounded-circle d-flex align-items-center justify-content-center text-white fw-bold me-2" style="width: 32px; height: 32px; font-size: 0.8rem;">
                    <%= activeUser.first_name ? activeUser.first_name.charAt(0).toUpperCase() : 'P' %>
                </div>
                <div class="overflow-hidden">
                    <div class="text-white text-truncate fw-semibold" style="font-size: 0.825rem;">
                        <%= activeUser.first_name ? (activeUser.first_name + ' ' + activeUser.last_name) : 'Officer' %>
                    </div>
                    <div class="text-warning text-truncate" style="font-size: 0.7rem;"><%= activeUser.role %></div>
                </div>
            </div>
        <% } %>
        <div class="text-white-50 pt-2 border-top border-secondary border-opacity-25" style="font-size: 0.68rem;">
            Malawi Police Service — Limbe Station
        </div>
    </div>
</aside>
