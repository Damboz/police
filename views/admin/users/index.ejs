<%- include('../../partials/header') %>

<div class="app-wrapper">
    <%- include('../../partials/sidebar') %>

    <div class="main-content">
        <%- include('../../partials/topbar') %>

        <div class="container-fluid py-4">
            
            <!-- Page Header -->
            <div class="d-flex align-items-center justify-content-between mb-4">
                <div>
                    <h4 class="fw-bold mb-1" style="color: var(--mps-navy);">
                        <i class="bi bi-people-fill me-2 text-warning"></i>Personnel & User Management
                    </h4>
                    <p class="text-muted small mb-0">Manage system access, roles, and officer credentials for Limbe Station.</p>
                </div>
                <a href="/admin/users/create" class="btn btn-primary fw-bold px-3">
                    <i class="bi bi-person-plus-fill me-2"></i>Register Personnel
                </a>
            </div>

            <!-- Filter & Search Toolbar -->
            <div class="card mb-4 border-0 shadow-sm">
                <div class="card-body p-3">
                    <form action="/admin/users" method="GET" class="row g-2 align-items-center">
                        <div class="col-12 col-md-5">
                            <div class="input-group">
                                <span class="input-group-text bg-light text-muted"><i class="bi bi-search"></i></span>
                                <input type="text" name="search" class="form-control" placeholder="Search by Badge, Name, or Email..." value="<%= searchQuery %>">
                            </div>
                        </div>
                        <div class="col-12 col-md-4">
                            <select name="role" class="form-select" onchange="this.form.submit()">
                                <option value="">All System Roles</option>
                                <option value="Admin" <%= roleFilter === 'Admin' ? 'selected' : '' %>>System Administrator</option>
                                <option value="Supervisor" <%= roleFilter === 'Supervisor' ? 'selected' : '' %>>Supervisor / Commander</option>
                                <option value="Investigator" <%= roleFilter === 'Investigator' ? 'selected' : '' %>>Investigator / Detective</option>
                                <option value="Police Officer" <%= roleFilter === 'Police Officer' ? 'selected' : '' %>>Police Officer / Desk</option>
                            </select>
                        </div>
                        <div class="col-12 col-md-3 d-flex gap-2">
                            <button type="submit" class="btn btn-secondary-mps w-100 fw-bold">Filter</button>
                            <% if (searchQuery || roleFilter) { %>
                                <a href="/admin/users" class="btn btn-outline-secondary">Clear</a>
                            <% } %>
                        </div>
                    </form>
                </div>
            </div>

            <!-- Users Table -->
            <div class="table-responsive shadow-sm">
                <table class="table align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Badge #</th>
                            <th>Officer Name</th>
                            <th>Rank</th>
                            <th>Assigned Role</th>
                            <th>Contact Email</th>
                            <th>Status</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (users.length === 0) { %>
                            <tr>
                                <td colspan="7" class="text-center py-4 text-muted">
                                    <i class="bi bi-folder-x fs-3 d-block mb-2"></i>
                                    No personnel records found.
                                </td>
                            </tr>
                        <% } else { %>
                            <% users.forEach(user => { %>
                                <tr>
                                    <td>
                                        <span class="fw-bold font-monospace text-primary"><%= user.badge_number %></span>
                                    </td>
                                    <td class="fw-semibold">
                                        <%= user.first_name %> <%= user.last_name %>
                                    </td>
                                    <td>
                                        <span class="badge bg-light text-dark border"><%= user.rank_title || 'N/A' %></span>
                                    </td>
                                    <td>
                                        <% if (user.role === 'Admin') { %>
                                            <span class="badge bg-dark">System Admin</span>
                                        <% } else if (user.role === 'Supervisor') { %>
                                            <span class="badge bg-warning text-dark">Supervisor</span>
                                        <% } else if (user.role === 'Investigator') { %>
                                            <span class="badge bg-info text-dark">Investigator</span>
                                        <% } else { %>
                                            <span class="badge bg-secondary">Police Officer</span>
                                        <% } %>
                                    </td>
                                    <td class="small text-muted"><%= user.email %></td>
                                    <td>
                                        <% if (user.is_active) { %>
                                            <span class="badge-status badge-closed">Active</span>
                                        <% } else { %>
                                            <span class="badge-status badge-critical">Deactivated</span>
                                        <% } %>
                                    </td>
                                    <td class="text-end">
                                        <form action="/admin/users/<%= user.id %>/toggle-status" method="POST" class="d-inline">
                                            <% if (user.is_active) { %>
                                                <button type="submit" class="btn btn-sm btn-outline-danger" title="Deactivate Account">
                                                    <i class="bi bi-person-x-fill me-1"></i>Deactivate
                                                </button>
                                            <% } else { %>
                                                <button type="submit" class="btn btn-sm btn-outline-success" title="Activate Account">
                                                    <i class="bi bi-person-check-fill me-1"></i>Activate
                                                </button>
                                            <% } %>
                                        </form>
                                    </td>
                                </tr>
                            <% }); %>
                        <% } %>
                    </tbody>
                </table>
            </div>

        </div>
    </div>
</div>

<%- include('../../partials/footer') %>