<%- include('../partials/header') %>

<div class="app-wrapper">
    <%- include('../partials/sidebar') %>

    <div class="main-content">
        <%- include('../partials/topbar') %>

        <div class="container-fluid py-4">
            
            <!-- Header -->
            <div class="d-flex align-items-center justify-content-between mb-4">
                <div>
                    <h4 class="fw-bold mb-1" style="color: var(--mps-navy);">
                        <i class="bi bi-shield-lock-fill me-2 text-warning"></i>System Administration Dashboard
                    </h4>
                    <p class="text-muted small mb-0">System health, quick administrative metrics, and recent security audit trail.</p>
                </div>
                <a href="/admin/users/create" class="btn btn-navy fw-bold px-3">
                    <i class="bi bi-person-plus-fill me-2"></i>Register New Personnel
                </a>
            </div>

            <!-- Flash Alert Messages -->
            <% if (success && success.length > 0) { %>
                <div class="alert alert-success alert-dismissible fade show small mb-4" role="alert">
                    <i class="bi bi-check-circle-fill me-2"></i><%= success %>
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            <% } %>

            <!-- Summary Cards -->
            <div class="row g-3 mb-4">
                <div class="col-12 col-sm-6 col-xl-4">
                    <div class="card border-0 shadow-sm p-3">
                        <div class="d-flex align-items-center justify-content-between">
                            <div>
                                <span class="text-muted small fw-semibold text-uppercase d-block mb-1">Total System Users</span>
                                <h3 class="fw-bold mb-0 text-primary"><%= stats.totalUsers %></h3>
                            </div>
                            <div class="p-3 bg-primary bg-opacity-10 rounded text-primary">
                                <i class="bi bi-people-fill fs-3"></i>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-12 col-sm-6 col-xl-4">
                    <div class="card border-0 shadow-sm p-3">
                        <div class="d-flex align-items-center justify-content-between">
                            <div>
                                <span class="text-muted small fw-semibold text-uppercase d-block mb-1">Active Accounts</span>
                                <h3 class="fw-bold mb-0 text-success"><%= stats.activeUsers %></h3>
                            </div>
                            <div class="p-3 bg-success bg-opacity-10 rounded text-success">
                                <i class="bi bi-person-check-fill fs-3"></i>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-12 col-sm-6 col-xl-4">
                    <div class="card border-0 shadow-sm p-3">
                        <div class="d-flex align-items-center justify-content-between">
                            <div>
                                <span class="text-muted small fw-semibold text-uppercase d-block mb-1">Total Logins Tracked</span>
                                <h3 class="fw-bold mb-0 text-dark"><%= stats.totalLogins %></h3>
                            </div>
                            <div class="p-3 bg-dark bg-opacity-10 rounded text-dark">
                                <i class="bi bi-shield-check fs-3"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Recent Security Audit Log Preview -->
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-navy text-white d-flex align-items-center justify-content-between py-3">
                    <h6 class="mb-0 fw-bold">
                        <i class="bi bi-journal-text me-2 text-warning"></i>Recent System Activity & Audit Trail
                    </h6>
                    <a href="/admin/audit-logs" class="btn btn-sm btn-outline-light">View Full Log</a>
                </div>
                <div class="table-responsive">
                    <table class="table align-middle mb-0">
                        <thead class="bg-light">
                            <tr>
                                <th>Timestamp</th>
                                <th>User / Officer</th>
                                <th>Action Performed</th>
                                <th>Details</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if (!recentLogs || recentLogs.length === 0) { %>
                                <tr>
                                    <td colspan="4" class="text-center py-4 text-muted">No recent activity recorded.</td>
                                </tr>
                            <% } else { %>
                                <% recentLogs.forEach(log => { %>
                                    <tr>
                                        <td class="small text-muted font-monospace">
                                            <%= new Date(log.created_at).toLocaleString() %>
                                        </td>
                                        <td class="fw-semibold small">
                                            <%= log.badge_number ? (log.first_name + ' ' + log.last_name + ' (' + log.badge_number + ')') : 'System Process' %>
                                        </td>
                                        <td>
                                            <span class="badge bg-secondary"><%= log.action %></span>
                                        </td>
                                        <td class="small"><%= log.details %></td>
                                    </tr>
                                <% }); %>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            </div>

        </div>
    </div>
</div>

<%- include('../partials/footer') %>